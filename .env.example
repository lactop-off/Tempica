# ── データベース ────────────────────────────────────────────────
DB_NAME=attendance
DB_USER=app
DB_PASSWORD=change-me-in-production

# backend / worker から参照する接続文字列。
# Docker 内では host を `db` に、ローカル起動時は `localhost` にする。
DATABASE_URL=postgres://app:change-me-in-production@localhost:5432/attendance

# ── 認証 / セッション ───────────────────────────────────────────
# セッション Cookie の署名に使う十分に長いランダム文字列。
# 例: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# ── アプリ設定 ─────────────────────────────────────────────────
PORT=3000
# フロントエンドのオリジン（CORS と Cookie 共有のため）
CORS_ORIGIN=http://localhost:8080

# ── メール（任意） ─────────────────────────────────────────────
# 通知・パスワードリセット用 SMTP。未設定ならメール送信はスキップされる。
# 例: smtp://user:pass@smtp.example.com:587
SMTP_URL=
SMTP_FROM=no-reply@example.com
